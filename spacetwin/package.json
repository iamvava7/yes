{
  "name": "spacetwin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Capture 360° panoramas, trace rooms, and share walkable 3D digital twins.",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build --config web/vite.config.js",
    "start": "node server/index.js",
    "test": "node --test \"test/*.test.js\"",
    "test:e2e": "node test-e2e/smoke.js",
    "sample:assets": "python3 scripts/make_sample.py assets/sample",
    "test:capture": "node test-e2e/capture.js",
    "phone": "PHONE=1 node scripts/dev.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "image-size": "^2.0.2",
    "jpeg-js": "^0.4.4",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "playwright-core": "^1.55.0",
    "three": "^0.180.0",
    "vite": "^7.1.0"
  }
}
