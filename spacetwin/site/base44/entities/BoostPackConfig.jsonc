{
  "name": "BoostPackConfig",
  "type": "object",
  "title": "BoostPackConfig",
  "properties": {
    "pack_id": {
      "type": "string",
      "title": "ID pachet (b1, b3, b6, b12)"
    },
    "boosts": {
      "type": "number",
      "title": "Num\u0103r boost-uri"
    },
    "price_ron": {
      "type": "number",
      "title": "Pre\u021b total (RON)"
    },
    "popular": {
      "type": "boolean",
      "default": false,
      "title": "Marcat Popular"
    },
    "single": {
      "type": "boolean",
      "default": false,
      "title": "Pachet unic (cump\u0103rare direct\u0103 de pe anun\u021b)"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "title": "Activ (vizibil la v\u00e2nzare)"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "title": "Ordine afi\u0219are"
    }
  },
  "required": [
    "pack_id",
    "boosts",
    "price_ron"
  ],
  "rls": {
    "read": null,
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "ADMIN"
          }
        },
        {
          "user_condition": {
            "role": "SUPER_ADMIN"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "SUPER_ADMIN"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "SUPER_ADMIN"
          }
        }
      ]
    }
  }
}