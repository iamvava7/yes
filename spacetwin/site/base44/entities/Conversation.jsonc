{
  "name": "Conversation",
  "type": "object",
  "title": "Conversation",
  "properties": {
    "property_id": {
      "type": "string",
      "title": "Property ID"
    },
    "property_title": {
      "type": "string",
      "title": "Titlu proprietate"
    },
    "buyer_id": {
      "type": "string",
      "title": "Buyer ID"
    },
    "buyer_name": {
      "type": "string",
      "title": "Nume cump\u0103r\u0103tor"
    },
    "seller_id": {
      "type": "string",
      "title": "Seller ID"
    },
    "seller_name": {
      "type": "string",
      "title": "Nume v\u00e2nz\u0103tor"
    },
    "last_message": {
      "type": "string",
      "title": "Ultimul mesaj"
    },
    "description": {
      "type": "string",
      "title": "Descriere",
      "maxLength": 1000
    }
  },
  "required": [
    "property_id",
    "buyer_id",
    "seller_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "ADMIN"
          }
        },
        {
          "user_condition": {
            "role": "SUPER_ADMIN"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "ADMIN"
          }
        },
        {
          "user_condition": {
            "role": "SUPER_ADMIN"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "ADMIN"
          }
        },
        {
          "user_condition": {
            "role": "SUPER_ADMIN"
          }
        }
      ]
    }
  }
}