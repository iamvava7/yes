{
  "name": "Notification",
  "type": "object",
  "title": "Notification",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "Recipient user ID"
    },
    "type": {
      "type": "string",
      "enum": [
        "comment",
        "reply",
        "like",
        "message",
        "property",
        "review",
        "system"
      ],
      "default": "system",
      "title": "Tip notificare"
    },
    "text": {
      "type": "string",
      "title": "Text"
    },
    "link": {
      "type": "string",
      "title": "Link"
    },
    "actor_name": {
      "type": "string",
      "title": "Autor"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "title": "Citit"
    }
  },
  "required": [
    "user_id",
    "type",
    "text"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "ADMIN"
          }
        },
        {
          "user_condition": {
            "role": "SUPER_ADMIN"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
