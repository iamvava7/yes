{
  "description": "Ruleaz\u0103 zilnic la 03:00 \u0219i apeleaz\u0103 ExpireBoosts pentru a marca boost-urile expirate.",
  "name": "Daily Expire Boosts",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_expire_boosts",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "expire_boosts": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "ExpireBoosts",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Expir\u0103 boost-urile",
            "description": "Marcheaz\u0103 boost-urile expirate"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}