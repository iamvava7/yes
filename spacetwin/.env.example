# Copy to .env next to package.json and fill in. Never commit .env.
# Every value here is a server setting; none of them reaches the browser.

# Where the site is reachable (used in emails, Google sign-in, listing links)
APP_URL=https://verificasa.ro
PORT=3000
# Database, uploaded photos and tours (back this folder up)
DATA_DIR=/var/lib/verificasa

# Your account becomes SUPER_ADMIN when you sign up with one of these
ADMIN_EMAILS=you@example.com

# Encrypts the API keys saved in Admin → Integrări & chei API (long random phrase)
INTEGRATIONS_MASTER_KEY=

# Email (sign-up codes, password resets, notifications) through resend.com
RESEND_API_KEY=
MAIL_FROM=VerifiCasa <no-reply@verificasa.ro>

# "Continue with Google" (console.cloud.google.com → Credentials → OAuth client;
# authorised redirect URI: https://verificasa.ro/api/platform/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# These can also be saved from the admin panel instead of here:
# StripeSecretKey=        StripePublic=        StripeWebhookSecret=
# ANTHROPIC_API_KEY=      GOOGLE_MAPS_API_KEY= Map=        Verificasa= (Kiri Engine)
